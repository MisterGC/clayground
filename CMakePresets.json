{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default",
            "inherits": "base",
            "displayName": "Default host build",
            "description": "Release build with tests, into ./build. Qt is taken from CMAKE_PREFIX_PATH in the environment - see README, 'How to build?'."
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug host build",
            "description": "Same as default but a Debug build, into ./build-debug.",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux",
            "inherits": "base",
            "displayName": "Linux",
            "description": "Default build, restricted to Linux hosts.",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos",
            "inherits": "base",
            "displayName": "macOS (Homebrew OpenSSL)",
            "description": "Default build plus a Homebrew OpenSSL hint, for hosts where libdatachannel cannot find one. /opt/homebrew/opt/openssl is a stable Homebrew symlink, not a versioned path, so it survives upgrades.",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "OPENSSL_ROOT_DIR": "/opt/homebrew/opt/openssl"
            }
        },
        {
            "name": "windows",
            "inherits": "base",
            "displayName": "Windows",
            "description": "Default build, restricted to Windows hosts.",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "linux",
            "configurePreset": "linux",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos",
            "configurePreset": "macos",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
