#
# Writes a qmldir that makes a QML-only plugin importable straight from its
# source directory, so an edit to one of its files is live on the next reload
# instead of after a rebuild and a restart (#570).
#
# Run as a script: cmake -DIN=<built qmldir> -DOUT=<qmldir to write>
#                        -DSRC_DIR=<the plugin's source directory> -P <this file>
#
# The built qmldir is the template, so the source module declares exactly the
# types, versions, singletons and imports the plugin does. Two kinds of lines
# are dropped: `prefer :/qt/qml/...` would send every lookup back into the
# compiled resources, and the plugin lines (plugin, classname, linktarget)
# would load the very library whose copies we bypass. typeinfo names a
# .qmltypes that exists only in the build directory. Each file entry is
# rewritten to point at the source file, relative to the new qmldir - an
# absolute Windows path ("C:/...") would read as a URL scheme.

if(NOT IN OR NOT OUT OR NOT SRC_DIR)
    message(FATAL_ERROR "claysourcemodule.cmake needs IN, OUT and SRC_DIR")
endif()

get_filename_component(_outDir "${OUT}" DIRECTORY)
file(STRINGS "${IN}" _lines)
set(_content "# Generated by cmake/claysourcemodule.cmake from ${IN} - do not edit.\n")
foreach(_line IN LISTS _lines)
    if(_line MATCHES "^(prefer|plugin|optional plugin|classname|linktarget|typeinfo)( |$)")
        continue()
    endif()
    if(_line MATCHES "^(.* )([^ ]+\\.(qml|js|mjs))$")
        set(_head "${CMAKE_MATCH_1}")
        file(RELATIVE_PATH _rel "${_outDir}" "${SRC_DIR}/${CMAKE_MATCH_2}")
        set(_line "${_head}${_rel}")
    endif()
    string(APPEND _content "${_line}\n")
endforeach()

# Only touch the file when it changes, or every build would look like an edit
# to a loader watching it.
set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _content)
    file(MAKE_DIRECTORY "${_outDir}")
    file(WRITE "${OUT}" "${_content}")
endif()
